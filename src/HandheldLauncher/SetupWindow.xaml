<Window x:Class="HandheldLauncher.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up Handheld Launcher" Width="820" Height="650" MinWidth="680" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Display, Segoe UI">
    <Grid Margin="34">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Set up your game folders" FontSize="32" FontWeight="Bold"/><TextBlock Text="Pick one or more places to browse. You can change these later with Y or F2." Margin="0,8,0,0" FontSize="16" Foreground="{StaticResource MutedBrush}"/></StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,14">
            <Button Content="＋ Add folder" Click="AddFolder_Click" Padding="18,10" FontSize="17" Margin="0,0,10,0"/>
            <Button Content="Remove selected" Click="RemoveFolder_Click" Padding="18,10" FontSize="17"/>
        </StackPanel>
        <ListBox x:Name="FolderList" Grid.Row="2" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="#34415B" BorderThickness="2" FontSize="18">
            <ListBox.ItemTemplate><DataTemplate><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <WrapPanel Grid.Row="3" Margin="0,18,0,18">
            <CheckBox x:Name="ConfirmCheck" Content="Confirm before launch" Margin="0,0,24,10" FontSize="16"/>
            <CheckBox x:Name="ExitCheck" Content="Exit after launch" Margin="0,0,24,10" FontSize="16"/>
            <CheckBox x:Name="HiddenCheck" Content="Show hidden files" Margin="0,0,24,10" FontSize="16"/>
        </WrapPanel>
        <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="SteamButton" Content="Add to Steam" Click="SteamButton_Click" Padding="20,12" FontSize="17" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancel" Click="Cancel_Click" Padding="20,12" FontSize="17" Margin="0,0,10,0"/><Button Content="Save and continue" Click="Save_Click" Padding="20,12" FontSize="17" FontWeight="Bold" Background="{StaticResource AccentBrush}" Foreground="#08120F"/></StackPanel>
        </Grid>
    </Grid>
</Window>
