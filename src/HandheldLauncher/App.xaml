<Application x:Class="HandheldLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0D111A"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#161C29"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FC"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA7BC"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#69E6C3"/>
    </Application.Resources>
</Application>
