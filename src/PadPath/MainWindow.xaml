<Window x:Class="PadPath.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PadPath" Width="1280" Height="720" MinWidth="720" MinHeight="450"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI" KeyDown="Window_KeyDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="BrowserItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="MinHeight" Value="66"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RootButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="20,12"/><Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PromptButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource DockTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource DockTextBrush}"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#22FFFFFF"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{DynamicResource AccentBrush}" MinHeight="148">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="34,25,260,25" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                <TextBlock x:Name="BreadcrumbText" Margin="0,9,0,0" FontSize="18" Foreground="{DynamicResource AccentTextBrush}" Opacity="0.82" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="18" Padding="14,7" VerticalAlignment="Center" Margin="0,0,34,0">
                <StackPanel Orientation="Horizontal"><Ellipse x:Name="ControllerDot" Width="10" Height="10" Fill="#69758A" Margin="0,0,8,0"/><TextBlock x:Name="ControllerText" Text="CONTROLLER" FontSize="13" FontWeight="Bold"/></StackPanel>
            </Border>
            <Border Grid.ColumnSpan="2" Height="12" Background="{DynamicResource PaletteBrush}" VerticalAlignment="Bottom"/>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="34,20,34,18">
            <StackPanel x:Name="RootButtons" Orientation="Horizontal"/>
        </ScrollViewer>

        <ListBox x:Name="BrowserList" Grid.Row="2" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource BrowserItemStyle}"
                 Margin="34,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="BrowserList_SelectionChanged" MouseDoubleClick="BrowserList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="80"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="7" Background="{DynamicResource PaletteBrush}" CornerRadius="4" HorizontalAlignment="Left">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="7" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Kind}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="23" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="›" FontSize="30" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Background="{DynamicResource AccentSecondaryBrush}" Margin="0,18,0,0">
          <Grid Margin="27,10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OpenPrompt" Content="Ⓐ OPEN / LAUNCH" Style="{StaticResource PromptButtonStyle}" Click="OpenPrompt_Click"/>
                <Button Content="Ⓑ BACK" Style="{StaticResource PromptButtonStyle}" Click="BackPrompt_Click"/>
                <Button Content="☰ ROOTS" Style="{StaticResource PromptButtonStyle}" Click="RootsPrompt_Click"/>
                <Button Content="Ⓨ SETTINGS" Style="{StaticResource PromptButtonStyle}" Click="SettingsPrompt_Click"/>
                <Button Content="▣ CLOSE" Style="{StaticResource PromptButtonStyle}" Click="ClosePrompt_Click"/>
            </StackPanel>
            <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource DockTextBrush}"/>
          </Grid>
        </Border>

        <Border x:Name="EmptyPanel" Grid.Row="2" Margin="34,0" Background="{DynamicResource PanelBrush}" CornerRadius="14" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Nothing launchable here" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Press B to go back or choose another root." Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="17"/></StackPanel>
        </Border>

        <Border x:Name="ConfirmationPanel" Grid.RowSpan="4" Background="#F20D111A" CornerRadius="18" Visibility="Collapsed" BorderBrush="{DynamicResource TextBrush}" BorderThickness="3" Padding="50" Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680">
                <TextBlock Text="Launch this game?" FontSize="34" FontWeight="Bold" TextAlignment="Center"/>
                <TextBlock x:Name="ConfirmationName" Margin="0,18,0,30" FontSize="24" Foreground="{DynamicResource AccentBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="LaunchButton" Content="Ⓐ  LAUNCH" Style="{StaticResource RootButtonStyle}" Click="LaunchButton_Click" BorderBrush="{StaticResource AccentBrush}"/>
                    <Button Content="Ⓑ  CANCEL" Style="{StaticResource RootButtonStyle}" Click="CancelButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
