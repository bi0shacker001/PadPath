<Window x:Class="PadPath.MainWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PadPath" Width="1280" Height="720" MinWidth="720" MinHeight="450" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Inter" KeyDown="Window_KeyDown" WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="ListBoxItem"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="18,13"/><Setter Property="MinHeight" Value="66"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="CornerRadius" Value="12"/></Style>
    <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/><Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/></Style>
    <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource SelectionBrush}"/></Style>
    <Style Selector="Button.rootButton"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Padding" Value="20,12"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.promptButton"><Setter Property="Foreground" Value="{DynamicResource DockTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,0,5,0"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="Button.promptButton:pointerover, Button.promptButton:focus"><Setter Property="BorderBrush" Value="{DynamicResource DockTextBrush}"/></Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Grid Grid.Row="0" Background="{DynamicResource AccentBrush}" MinHeight="148" ColumnDefinitions="*,Auto">
      <StackPanel Margin="34,25,260,25" VerticalAlignment="Center"><TextBlock x:Name="TitleText" FontSize="36" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/><TextBlock x:Name="BreadcrumbText" Margin="0,9,0,0" FontSize="18" Foreground="{DynamicResource AccentTextBrush}" Opacity="0.82" TextTrimming="CharacterEllipsis"/></StackPanel>
      <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="18" Padding="14,7" VerticalAlignment="Center" Margin="0,0,34,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ControllerDot" Width="10" Height="10" Fill="#69758A" Margin="0,0,8,0"/><TextBlock x:Name="ControllerText" Text="CONTROLLER" FontSize="13" FontWeight="Bold"/></StackPanel></Border>
      <Border Grid.ColumnSpan="2" Height="12" Background="{DynamicResource PaletteBrush}" VerticalAlignment="Bottom"/>
    </Grid>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="34,20,34,18"><StackPanel x:Name="RootButtons" Orientation="Horizontal"/></ScrollViewer>
    <ListBox x:Name="BrowserList" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="34,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="BrowserList_SelectionChanged" DoubleTapped="BrowserList_DoubleTapped">
      <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="80,*,Auto"><Border Grid.Column="0" Background="{DynamicResource AccentBrush}" CornerRadius="7" Padding="8,5" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Kind}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="›" FontSize="30" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Row="3" Background="{DynamicResource AccentSecondaryBrush}" Margin="0,18,0,0"><Grid Margin="27,10" ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal"><Button x:Name="OpenPrompt" Content="Ⓐ OPEN / LAUNCH" Classes="promptButton" Click="OpenPrompt_Click"/><Button Content="Ⓑ BACK" Classes="promptButton" Click="BackPrompt_Click"/><Button Content="☰ ROOTS" Classes="promptButton" Click="RootsPrompt_Click"/><Button Content="Ⓨ SETTINGS" Classes="promptButton" Click="SettingsPrompt_Click"/><Button Content="▣ CLOSE" Classes="promptButton" Click="ClosePrompt_Click"/></StackPanel><TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource DockTextBrush}"/></Grid></Border>
    <Border x:Name="EmptyPanel" Grid.Row="2" Margin="34,0" Background="{DynamicResource PanelBrush}" CornerRadius="14" IsVisible="False"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Nothing launchable here" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Press B to go back or choose another root." Margin="0,10,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="17"/></StackPanel></Border>
    <Border x:Name="ConfirmationPanel" Grid.RowSpan="4" Background="#F20D111A" CornerRadius="18" IsVisible="False" BorderBrush="{DynamicResource TextBrush}" BorderThickness="3" Padding="50" ZIndex="10"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="680"><TextBlock Text="Launch this game?" FontSize="34" FontWeight="Bold" TextAlignment="Center"/><TextBlock x:Name="ConfirmationName" Margin="0,18,0,30" FontSize="24" Foreground="{DynamicResource AccentBrush}" TextAlignment="Center" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button x:Name="LaunchButton" Content="Ⓐ  LAUNCH" Classes="rootButton" Click="LaunchButton_Click"/><Button Content="Ⓑ  CANCEL" Classes="rootButton" Click="CancelButton_Click"/></StackPanel></StackPanel></Border>
  </Grid>
</Window>
