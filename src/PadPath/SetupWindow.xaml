<Window x:Class="PadPath.SetupWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up PadPath" Width="820" Height="650" MinWidth="680" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Inter">
  <Window.Styles>
    <Style Selector="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="CheckBox /template/ ContentPresenter"><Setter Property="TextBlock.Foreground" Value="{DynamicResource TextBrush}"/></Style>
  </Window.Styles>
  <Grid Margin="34" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
    <StackPanel><TextBlock Text="Set up your game folders" FontSize="32" FontWeight="Bold"/><TextBlock Text="Pick one or more places to browse. You can change these later with Y or F2." Margin="0,8,0,0" FontSize="16" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,14"><Button Content="＋ Add folder" Click="AddFolder_Click" Padding="18,10" FontSize="17" Margin="0,0,10,0"/><Button Content="Remove selected" Click="RemoveFolder_Click" Padding="18,10" FontSize="17"/></StackPanel>
    <ListBox x:Name="FolderList" Grid.Row="2" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" FontSize="18">
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="10" ColumnDefinitions="180,*"><TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="3" Margin="0,16,0,8" ColumnDefinitions="Auto,270,Auto,170"><TextBlock Text="Color palette" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/><ComboBox x:Name="ThemeCombo" Grid.Column="1" FontSize="17" Padding="10,7" SelectionChanged="ThemeCombo_SelectionChanged"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Rectangle Width="18" Height="18" Fill="{Binding Preview1}"/><Rectangle Width="18" Height="18" Fill="{Binding Preview2}"/><Rectangle Width="18" Height="18" Fill="{Binding Preview3}" Margin="0,0,9,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Grid.Column="2" Text="Appearance" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="22,0,10,0"/><ComboBox x:Name="AppearanceCombo" Grid.Column="3" FontSize="17" Padding="10,7" SelectionChanged="AppearanceCombo_SelectionChanged"/></Grid>
    <WrapPanel Grid.Row="4" Margin="0,10,0,18"><CheckBox x:Name="ConfirmCheck" Content="Confirm before launch" Margin="0,0,24,10" FontSize="16"/><CheckBox x:Name="HiddenCheck" Content="Show hidden files" Margin="0,0,24,10" FontSize="16"/></WrapPanel>
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto"><Button x:Name="SteamButton" Content="Add to Steam" Click="SteamButton_Click" Padding="20,12" FontSize="17" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancel" Click="Cancel_Click" Padding="20,12" FontSize="17" Margin="0,0,10,0"/><Button Content="Save and continue" Click="Save_Click" Padding="20,12" FontSize="17" FontWeight="Bold" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/></StackPanel></Grid>
  </Grid>
</Window>
